{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Envoy",
  "colors": {
    "primary": "#0129DD",
    "light": "#053EF0",
    "dark": "#001FA6"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "fonts": {
    "family": "Instrument Sans",
    "source": "https://fonts.bunny.net/instrument-sans/files/instrument-sans-latin-400-normal.woff2",
    "format": "woff2",
    "heading": {
      "family": "Instrument Sans",
      "weight": "700"
    }
  },
  "background": {
    "color": {
      "light": "#F7F7F7",
      "dark": "#010101"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Contact",
        "href": "mailto:contact@hello-envoy.com"
      }
    ],
    "primary": {

  "navigation": {
    "tabs": [
      {
        "tab": "Help Center",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "help-center/get-started/introduction",
              "help-center/get-started/quickstart",
              "help-center/get-started/account-setup"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "help-center/concepts/overview",
              "help-center/concepts/workspaces",
              "help-center/concepts/users-and-roles",
              "help-center/concepts/integrations"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "help-center/guides/first-integration",
              "help-center/guides/managing-users",
              "help-center/guides/notifications",
              "help-center/guides/data-export"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "help-center/configuration/settings",
              "help-center/configuration/security",
              "help-center/configuration/billing"
            ]
          },
          {
            "group": "FAQ",
            "pages": [
              "help-center/faq/general",
              "help-center/faq/billing",
              "help-center/faq/integrations"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "help-center/troubleshooting/common-issues",
              "help-center/troubleshooting/error-codes",
              "help-center/troubleshooting/contact-support"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Comparisons",
            "pages": [
              "resources/why-envoy",
              "resources/comparison-overview",
              "resources/enterprise-vs-starter"
            ]
          },
          {
            "group": "Blog",
            "pages": [
              "resources/blog/index",
              "resources/blog/product-updates",
              "resources/blog/best-practices"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/hello-envoy/"
